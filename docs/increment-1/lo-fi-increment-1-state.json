{
  "target": "docs/ux/lo-fi/increment-1.drawio",
  "screens": [
    {
      "name": "game directory prompt",
      "layout": "modal",
      "col": 0,
      "row": 0,
      "regions": [
        {
          "name": "directory entry form",
          "slot": "body",
          "type": "form",
          "fields": [
            { "label": "COH Game Directory", "input": "text" },
            { "label": "Validation feedback", "input": "text" }
          ],
          "buttons": [
            { "label": "Browse..." },
            { "label": "Continue", "primary": true }
          ]
        }
      ]
    },
    {
      "name": "character explorer",
      "layout": "panel-with-collapsed-tabs",
      "col": 1,
      "row": 0,
      "regions": [
        {
          "name": "toolbar",
          "slot": "panel",
          "type": "toolbar",
          "buttons": [
            { "label": "New" },
            { "label": "Cut" },
            { "label": "Find" },
            { "label": "Clone" },
            { "label": "Paste" },
            { "label": "+Crowd" },
            { "label": "Del" },
            { "label": "Edit" }
          ]
        },
        {
          "name": "filter bar",
          "slot": "panel",
          "type": "form",
          "fields": [
            { "label": "Filter by Name", "input": "text", "placeholder": "Spyder" }
          ]
        },
        {
          "name": "crowd tree",
          "slot": "panel",
          "type": "tree",
          "nodes": [
            {
              "label": "All Characters",
              "expanded": true,
              "children": [
                { "label": "Crowd 1", "expanded": false },
                {
                  "label": "Crowd 2",
                  "expanded": true,
                  "children": [
                    { "label": "Character 1" },
                    { "label": "Character 2" },
                    { "label": "Character 3" },
                    { "label": "Spyder", "selected": true }
                  ]
                },
                { "label": "Crowd 3", "expanded": false },
                { "label": "Crowd 4", "expanded": false },
                { "label": "Crowd 5", "expanded": false },
                { "label": "Crowd 6", "expanded": false },
                { "label": "Crowd 7", "expanded": false },
                { "label": "Crowd 8", "expanded": false },
                { "label": "Crowd 9", "expanded": false }
              ]
            }
          ]
        },
        {
          "name": "collapsed side tabs",
          "slot": "side",
          "type": "collapsed-tabs",
          "tabs": [
            { "label": "Active Roster" },
            { "label": "Edit Character" }
          ]
        }
      ]
    },
    {
      "name": "context menu",
      "layout": "popup-overlay",
      "col": 2,
      "row": 0,
      "regions": [
        {
          "name": "context menu items",
          "slot": "body",
          "type": "menu",
          "groups": [
            {
              "items": [
                { "label": "New", "shortcut": "Ctrl+N" },
                { "label": "Edit", "shortcut": "Ctrl+E" },
                { "label": "Delete", "shortcut": "Del" },
                { "label": "Save", "shortcut": "Ctrl+S" }
              ]
            },
            {
              "items": [
                { "label": "Cut", "shortcut": "Ctrl+X" },
                { "label": "Clone", "shortcut": "Ctrl+C" },
                { "label": "Link", "shortcut": "Ctrl+L" },
                { "label": "Paste", "shortcut": "Ctrl+V" }
              ]
            },
            {
              "items": [
                { "label": "Spawn", "shortcut": "Alt+S" },
                { "label": "Place", "shortcut": "Alt+P" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "connections": [
    {
      "from": "game directory prompt",
      "to": "character explorer",
      "label": "valid path"
    }
  ]
}
