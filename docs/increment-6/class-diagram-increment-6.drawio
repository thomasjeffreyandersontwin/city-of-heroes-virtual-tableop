  <diagram id="page_attack_configuration" name="Attack Configuration">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i style=&quot;font-size:9px;color:#888;&quot;&gt;«from: Combat Execution»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Combat Execution&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;+ pair resolution sequence : Attacker-Defender Pair&lt;br/&gt;+ play attack animation : Attack Animation, Attacker&lt;br/&gt;+ play on-hit animation : On-Hit Animation, Defender&lt;br/&gt;+ apply knockback : Knockback Movement, Defender&lt;br/&gt;+ apply status effect : Status Effect, Defender&lt;br/&gt;+ update indicators : Attack State Indicator&lt;br/&gt;+ abort execution : Combat State&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;&lt;br/&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 4;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
