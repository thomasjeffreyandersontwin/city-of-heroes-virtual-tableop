      "shape:Eki5D2Dlq0CX_m2dVqxHX": {
        "x": 1795.4691503628064,
        "y": -188.0031943409477,
        "rotation": 0,
        "isLocked": false,
        "opacity": 1,
        "meta": {},
        "id": "shape:Eki5D2Dlq0CX_m2dVqxHX",
        "type": "text",
        "props": {
          "color": "black",
          "size": "s",
          "w": 749.3199588477369,
          "font": "draw",
          "textAlign": "start",
          "autoSize": false,
          "scale": 1,
          "richText": {
            "type": "doc",
            "attrs": {
              "dir": "auto"
            },
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      },
                      {
                        "type": "italic"
                      }
                    ],
                    "text": "COH game directory"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• the file-system path to the City of Heroes installation, validated at startup"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• provides the root path for the COH data directory where the crowd repository JSON file is stored and read"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• stored in application configuration and prompted from the GM when absent or invalid"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "I"
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "italic"
                      }
                    ],
                    "text": "nvariant: the "
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      },
                      {
                        "type": "italic"
                      }
                    ],
                    "text": "crowd repository"
                  },
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "italic"
                      }
                    ],
                    "text": " cannot be loaded or saved until the COH game directory is confirmed valid"
                  }
                ]
              }
            ]
          }
        },
        "parentId": "page:page",
        "index": "auU27E5G",
        "typeName": "shape"
      },
