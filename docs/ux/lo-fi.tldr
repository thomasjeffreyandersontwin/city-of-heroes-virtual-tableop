      "shape:scr3_tree_text": {
        "x": 4119.936063902243,
        "y": -718.0656766279128,
        "rotation": 0,
        "isLocked": false,
        "opacity": 1,
        "meta": {
          "note": "Tree content; uses domain terms; indicates selected item, gang mode toggle, drag handle"
        },
        "id": "shape:scr3_tree_text",
        "type": "text",
        "typeName": "shape",
        "index": "aXq93npV",
        "parentId": "page:page",
        "props": {
          "color": "black",
          "size": "s",
          "w": 470,
          "font": "draw",
          "textAlign": "start",
          "autoSize": false,
          "scale": 1,
          "richText": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "All Characters Crowd (protected)"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "  Animals"
                  }
                ]
