      "shape:legend_s3": {
        "x": 3896.6793186872496,
        "y": -184.54245212068258,
        "rotation": 0,
        "isLocked": false,
        "opacity": 1,
        "meta": {
          "note": "Legend for Screen 3"
        },
        "id": "shape:legend_s3",
        "type": "text",
        "typeName": "shape",
        "index": "arnhbVQV",
        "parentId": "page:page",
        "props": {
          "color": "black",
          "size": "s",
          "w": 757.025588031677,
          "font": "draw",
          "textAlign": "start",
          "autoSize": false,
          "scale": 1,
          "richText": {
            "type": "doc",
            "attrs": {
              "dir": "auto"
            },
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Create Crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN the GM creates a crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN a unique default name is added to the hierarchy"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• AND it appears selected and ready to rename"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• AND gang mode defaults to true"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Rename Crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN the GM renames a crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN the name updates immediately in crowd manager"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• AND duplicate sibling name is rejected (prior name kept)"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Delete Crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN the GM deletes a crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN the crowd and all its crowd members are removed from the hierarchy"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• BUT attempting to delete all characters crowd is blocked"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Create Character in Crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN the GM creates a character"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN a unique default name is added to the selected crowd"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• AND three canonical option groups are initialized (Identities, Abilities, Movements)"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Filter Characters by Name"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN the GM types in Filter characters by name"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN only matching items and ancestor crowds remain visible"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Save Crowd Collection to Repository"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN the GM saves"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN the full crowd hierarchy is serialized to JSON and written atomically"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• BUT if save fails due to disk error, in-memory state is unchanged and GM is notified"
                  }
                ]
              }
            ]
          }
        }
      },
