      "shape:legend_s2": {
        "x": 2864.3710251275525,
        "y": -183.03490814662212,
        "rotation": 0,
        "isLocked": false,
        "opacity": 1,
        "meta": {
          "note": "Legend for Screen 2"
        },
        "id": "shape:legend_s2",
        "type": "text",
        "typeName": "shape",
        "index": "aqgrRp0V",
        "parentId": "page:page",
        "props": {
          "color": "black",
          "size": "s",
          "w": 798.153101610359,
          "font": "draw",
          "textAlign": "start",
          "autoSize": false,
          "scale": 1,
          "richText": {
            "type": "doc",
            "attrs": {
              "dir": "auto"
            },
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Story: Load Prism Shell and Module"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN startup begins (after the COH game directory is confirmed)"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN the application shell initializes and all services are registered"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• AND the application is ready to display the crowd manager"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                }
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• WHEN a required service cannot be resolved during initialization"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• THEN the application surfaces a startup error"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "• BUT does not continue with a partially initialized state"
                  }
                ]
              }
            ]
          }
        }
      },
