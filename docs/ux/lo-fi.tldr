            "content": [
              {
                "type": "heading",
                "attrs": {
                  "dir": "auto",
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "crowd"
                  }
                ]
              },
              {
                "type": "bulletList",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "contains an ordered, name-keyed collection of "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd members"
                          },
                          {
                            "type": "text",
                            "text": ", which may be "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "characters"
                          },
                          {
                            "type": "text",
                            "text": " or nested "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowds"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "adds, removes, clones, and reorders "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd members"
                          },
                          {
                            "type": "text",
                            "text": "; notifies observers on every structural change"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "filters its visible "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd members"
                          },
                          {
                            "type": "text",
                            "text": " by name regex, collapsing non-matching branches and expanding matching ones"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Invariant:"
                          },
                          {
                            "type": "text",
                            "text": " "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd member"
                          },
                          {
                            "type": "text",
                            "text": " names must be unique within a "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
                          },
                          {
                            "type": "text",
                            "text": " — the collection is keyed by name and rejects duplicates"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "attrs": {
                  "dir": "auto",
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "crowd member"
                  }
                ]
              },
              {
                "type": "bulletList",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "participates in one or more "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowds"
                          },
                          {
                            "type": "text",
                            "text": " by maintaining a back-reference to its "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "roster crowd"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "can be cloned into an independent copy, linked across multiple "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowds"
                          },
                          {
                            "type": "text",
                            "text": " as a shared reference, or flattened into a numbered standalone "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "character"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Invariant:"
                          },
                          {
                            "type": "text",
                            "text": " a "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd member's"
                          },
                          {
                            "type": "text",
                            "text": " name must be unique within any "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
                          },
                          {
                            "type": "text",
                            "text": " it belongs to at any moment"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "attrs": {
                  "dir": "auto",
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "all characters crowd"
                  }
                ]
              },
              {
                "type": "bulletList",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "is a special protected root "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
                          },
                          {
                            "type": "text",
                            "text": " that aggregates every "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "character"
                          },
                          {
                            "type": "text",
                            "text": " in the "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd repository"
                          },
                          {
                            "type": "text",
                            "text": " as a flat alphabetically sorted list"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "is automatically maintained — any "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "character"
                          },
                          {
                            "type": "text",
                            "text": " added to any "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
                          },
                          {
                            "type": "text",
                            "text": " also appears here"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "cannot be deleted; attempts to delete it are blocked"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Invariant:"
                          },
                          {
                            "type": "text",
                            "text": " the "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
