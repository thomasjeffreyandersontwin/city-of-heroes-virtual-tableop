                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "is created with a unique name within its containing "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "can be renamed, cloned into an independent copy, or deleted from a "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
