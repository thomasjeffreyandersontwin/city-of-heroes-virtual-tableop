                  {
                    "type": "listItem",
                    "attrs": {
                      "dir": "auto"
                    },
                    "content": [
                      {
                        "type": "paragraph",
                        "attrs": {
                          "dir": "auto"
                        },
                        "content": [
                          {
                            "type": "text",
                            "text": "is serialized as part of the "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd"
                          },
                          {
                            "type": "text",
                            "text": " hierarchy when the "
                          },
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "crowd repository"
