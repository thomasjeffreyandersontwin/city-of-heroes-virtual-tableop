                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "italic"
                              }
                            ],
                            "text": "option group"
                          },
                          {
                            "type": "text",
                            "text": " for each capability class — Identities, Abilities, Movements — created on demand and never absent, even when empty in this increment"
