{
  "target": "docs/ux/lo-fi/increment-5.drawio",
  "screens": [
    {
      "name": "crowd manager — identities",
      "layout": "sidebar",
      "col": 1,
      "row": 0,
      "regions": [
        {
          "name": "crowd tree",
          "slot": "panel",
          "type": "list",
          "columns": ["crowd / character", "cnt"],
          "rows": 5
        },
        {
          "name": "tab bar",
          "slot": "body",
          "type": "nav-tabs",
          "tabs": [
            { "label": "Identities", "active": true },
            { "label": "Abilities" },
            { "label": "Movements" }
          ]
        },
        {
          "name": "identity list",
          "slot": "body",
          "type": "list",
          "columns": ["name", "type", "active", "default"],
          "rows": 3,
          "actions": [
            { "label": "Add" },
            { "label": "Remove" },
            { "label": "Set Active", "primary": true }
          ]
        }
      ]
    },
    {
      "name": "desktop",
      "layout": "split-screen",
      "col": 3,
      "row": 0,
      "regions": [
        {
          "name": "roster panel",
          "slot": "left",
          "type": "list",
          "columns": ["character name", "spawned", "active", "status"],
          "rows": 6,
          "actions": [
            { "label": "Add" },
            { "label": "Add Crowd" },
            { "label": "Spawn", "primary": true },
            { "label": "Remove" },
            { "label": "Clear" }
          ]
        },
        {
          "name": "roster panel — activation",
          "slot": "left",
          "type": "button-bar",
          "buttons": [
            { "label": "Activate", "primary": true },
            { "label": "Deactivate" },
            { "label": "Activate Gang" },
            { "label": "Deactivate Gang" }
          ]
        },
        {
          "name": "game overlay",
          "slot": "right",
          "type": "list",
          "columns": ["character overlay", "status indicator"],
          "rows": 4,
          "actions": [
            { "label": "Select" },
            { "label": "Multi-Select" },
            { "label": "Drag to Position" },
            { "label": "Dbl-Click to Activate", "primary": true }
          ]
        },
        {
          "name": "context menu",
          "slot": "right",
          "type": "list",
          "columns": ["target character"],
          "rows": 3,
          "actions": [
            { "label": "Spawn" },
            { "label": "Place at Location" },
            { "label": "Save Position" },
            { "label": "Move Camera to Target" },
            { "label": "Move Target to Camera" },
            { "label": "Reset Orientation" },
            { "label": "Maneuver w/ Camera" },
            { "label": "Activate Option", "primary": true },
            { "label": "Clone-Link" }
          ]
        }
      ]
    },
    {
      "name": "attack configuration",
      "layout": "flyout",
      "col": 4,
      "row": 0,
      "regions": [
        {
          "name": "combatant selectors",
          "slot": "body",
          "type": "list",
          "columns": ["character name", "role"],
          "rows": 3,
          "actions": [
            { "label": "Select Attacker" },
            { "label": "Add Defender" },
            { "label": "Confirm Targets", "primary": true }
          ]
        },
        {
          "name": "attack parameters",
          "slot": "body",
          "type": "form",
          "fields": [
            { "label": "Attack Effect", "input": "dropdown", "options": ["Stunned", "Unconscious", "Dying", "Dead"] },
            { "label": "Knockback Distance", "input": "text" },
            { "label": "Attack Result", "input": "dropdown", "options": ["Hit", "Miss"] },
            { "label": "Attack Mode", "input": "dropdown", "options": ["Attack", "Defend"] }
          ],
          "buttons": [
            { "label": "Confirm", "primary": true },
            { "label": "Cancel" },
            { "label": "Abort" }
          ]
        }
      ]
    }
  ],
  "connections": [
    {
      "from": "crowd manager — identities",
      "to": "desktop",
      "label": "starts game session"
    },
    {
      "from": "desktop",
      "to": "attack configuration",
      "label": "activates attack ability"
    }
  ]
}
